      "BINARY": "T_STR",
      "VARBINARY": "T_STR",
      "BLOB": "T_STR",
      "HEX": "T_STR",
      "ENUM": "T_STR",
      "SET": "T_STR",
      "JSON": "T_STR",
      "BOOL": "T_BOOL",
      "BOOLEAN": "T_BOOL",
      "TRUE": "T_BOOL",
      "FALSE": "T_BOOL",
      "NULL": "T_ANY"
    },
    "compatibility": {
      "strict": {
        "T_ANY": ["T_ANY", "T_CMP", "T_BOOL", "T_STR"],
        "T_CMP": ["T_CMP"],
        "T_BOOL": ["T_BOOL"],
        "T_STR": ["T_STR"]
      },
      "weak": {
        "T_CMP": ["T_BOOL", "T_STR"],
        "T_BOOL": ["T_CMP"],
        "T_STR": ["T_CMP", "T_BOOL"]
      },
      "try": {
        "T_BOOL": ["T_STR"],
        "T_STR": ["T_BOOL"]
      }
    },
    "terminal_tokens": {
      "COL_INT": "INT",
      "COL_FLOAT": "FLOAT",
      "COL_STRING": "STRING",
      "VALUE_TYPICAL_INT": "INT",
      "VALUE_TYPICAL_FLOAT": "FLOAT",
      "VALUE_TYPICAL_STRING": "STRING",
      "NULL": "T_CMP",
