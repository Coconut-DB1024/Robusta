    "AND": 20, "&&": 20,
    "NOT": 25,
    "BETWEEN": 30, "NOT BETWEEN": 30,
    "CASE": 30, "WHEN": 30, "THEN": 30, "ELSE": 30,
    "=": 40, "<=>": 40, ">=": 40, ">": 40, "<=": 40, "<": 40, "<>": 40, "!=": 40,
    "IS": 40, "LIKE": 40, "NOT LIKE": 40, "REGEXP": 40, "NOT REGEXP": 40, "IN": 40, "NOT IN": 40,
    "|": 50, "&": 55, "<<": 60, ">>": 60,
    "+": 70, "-": 70,
    "*": 80, "/": 80, "%": 80, "DIV": 80, "MOD": 80,
