      "SESSION_USER()": "T_STR",
      "SYSTEM_USER()": "T_STR",
      "VERSION()": "T_STR",
      "CONNECTION_ID()": "T_CMP"
    },
    "callable_terminal_tokens": [
      "PI()",
      "DATABASE()",
      "CURRENT_USER()",
      "SESSION_USER()",
      "SYSTEM_USER()",
      "VERSION()",
      "CONNECTION_ID()"
    ],
    "core_scored_tokens": [
      "=", "!=", "<", "<=", ">", ">=", "LIKE", "AND", "OR", "XOR",
      "&", "|", "^", "+", "-", "*", "/", "IS", "NOT", "IN", "BETWEEN"
    ],
    "extension_scored_tokens": [
