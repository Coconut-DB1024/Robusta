      "NOT LIKE", "REGEXP", "NOT REGEXP", "NOT BETWEEN",
      "ABS()", "FLOOR()", "CEIL()", "ROUND()", "LENGTH()",
      "SIGN()", "SQRT()", "LOG()", "LOG10()", "EXP()",
      "CHAR_LENGTH()", "ASCII()",
      "LOWER()", "UPPER()", "REVERSE()", "TRIM()",
      "DIV", "MOD", "<<", ">>", "TRUNCATE()", "BIT_COUNT()",
      "DEGREES()", "RADIANS()", "SIN()", "COS()", "TAN()", "ATAN()",
      "BIT_LENGTH()", "OCTET_LENGTH()", "CRC32()", "STRCMP()",
      "LTRIM()", "RTRIM()",
      "QUOTE()", "ORD()", "OCT()", "MD5()", "SHA1()", "TO_BASE64()",
