      "IS NULL", "IS NOT NULL", "IS TRUE", "IS FALSE",
      "VALUE_SINGULAR_INT", "VALUE_SINGULAR_FLOAT", "VALUE_SINGULAR_STRING",
      "HOLE_T_CMP", "HOLE_T_STR", "HOLE_T_BOOL"
