{
  "description": "MySQL Robust Rules for Fuzzing (Enhanced)",
  "types": {
    "T_BOOL": "Boolean logic (TRUE/FALSE)",
    "T_CMP": "Comparable (Numbers, Strings, Dates)",
    "T_STR": "Strict String",
    "T_ANY": "Any type"
  },
  "definitions": {
    "AND": ["T_BOOL", ["T_BOOL", "T_BOOL"]],
    "&&": ["T_BOOL", ["T_BOOL", "T_BOOL"]],
    "OR": ["T_BOOL", ["T_BOOL", "T_BOOL"]],
    "||": ["T_BOOL", ["T_BOOL", "T_BOOL"]],
    "XOR": ["T_BOOL", ["T_BOOL", "T_BOOL"]],

    "NOT": ["T_BOOL", ["T_BOOL"]],
    "!": ["T_BOOL", ["T_BOOL"]],
    "~": ["T_CMP", ["T_CMP"]],

    ">": ["T_BOOL", ["T_CMP", "T_CMP"]],
    ">=": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "<": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "<=": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "=": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "<=>": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "!=": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "<>": ["T_BOOL", ["T_CMP", "T_CMP"]],

    "LIKE": ["T_BOOL", ["T_STR", "T_STR"]],
    "NOT LIKE": ["T_BOOL", ["T_STR", "T_STR"]],
    "REGEXP": ["T_BOOL", ["T_STR", "T_STR"]],
    "NOT REGEXP": ["T_BOOL", ["T_STR", "T_STR"]],
    "IN": ["T_BOOL", ["T_CMP", "T_CMP"]],
    "IS": ["T_BOOL", ["T_ANY", "T_ANY"]],

    "BETWEEN": ["T_BOOL", ["T_CMP", "T_CMP", "T_CMP"]],
    "NOT BETWEEN": ["T_BOOL", ["T_CMP", "T_CMP", "T_CMP"]],

    "+": ["T_CMP", ["T_CMP", "T_CMP"]],
    "-": ["T_CMP", ["T_CMP", "T_CMP"]],
    "*": ["T_CMP", ["T_CMP", "T_CMP"]],
    "/": ["T_CMP", ["T_CMP", "T_CMP"]],
    "%": ["T_CMP", ["T_CMP", "T_CMP"]],

    "&": ["T_CMP", ["T_CMP", "T_CMP"]],
    "|": ["T_CMP", ["T_CMP", "T_CMP"]],
    "^": ["T_CMP", ["T_CMP", "T_CMP"]],

    "ABS()": ["T_CMP", ["T_CMP"]],
    "FLOOR()": ["T_CMP", ["T_CMP"]],
    "CEIL()": ["T_CMP", ["T_CMP"]],
    "ROUND()": ["T_CMP", ["T_CMP"]],
    "LENGTH()": ["T_CMP", ["T_STR"]],

    "SIGN()": ["T_CMP", ["T_CMP"]],
    "SQRT()": ["T_CMP", ["T_CMP"]],
    "LOG()": ["T_CMP", ["T_CMP"]],
    "LOG10()": ["T_CMP", ["T_CMP"]],
    "EXP()": ["T_CMP", ["T_CMP"]],
    "CHAR_LENGTH()": ["T_CMP", ["T_STR"]],
    "ASCII()": ["T_CMP", ["T_STR"]],
    "LOWER()": ["T_STR", ["T_STR"]],
    "UPPER()": ["T_STR", ["T_STR"]],
    "REVERSE()": ["T_STR", ["T_STR"]],
    "TRIM()": ["T_STR", ["T_STR"]],

    "DIV": ["T_CMP", ["T_CMP", "T_CMP"]],
    "MOD": ["T_CMP", ["T_CMP", "T_CMP"]],
    "<<": ["T_CMP", ["T_CMP", "T_CMP"]],
    ">>": ["T_CMP", ["T_CMP", "T_CMP"]],
    "TRUNCATE()": ["T_CMP", ["T_CMP", "T_CMP"]],
    "BIT_COUNT()": ["T_CMP", ["T_CMP"]],
    "DEGREES()": ["T_CMP", ["T_CMP"]],
    "RADIANS()": ["T_CMP", ["T_CMP"]],
    "SIN()": ["T_CMP", ["T_CMP"]],
    "COS()": ["T_CMP", ["T_CMP"]],
    "TAN()": ["T_CMP", ["T_CMP"]],
    "ATAN()": ["T_CMP", ["T_CMP"]],
    "BIT_LENGTH()": ["T_CMP", ["T_STR"]],
    "OCTET_LENGTH()": ["T_CMP", ["T_STR"]],
    "CRC32()": ["T_CMP", ["T_STR"]],
    "STRCMP()": ["T_CMP", ["T_STR", "T_STR"]],
    "LTRIM()": ["T_STR", ["T_STR"]],
    "RTRIM()": ["T_STR", ["T_STR"]],

    "QUOTE()": ["T_STR", ["T_STR"]],
    "ORD()": ["T_CMP", ["T_STR"]],
    "OCT()": ["T_STR", ["T_CMP"]],
    "MD5()": ["T_STR", ["T_STR"]],
    "SHA1()": ["T_STR", ["T_STR"]],
    "TO_BASE64()": ["T_STR", ["T_STR"]],
    "FROM_BASE64()": ["T_STR", ["T_STR"]],
    "COMPRESS()": ["T_STR", ["T_STR"]],
    "COLLATION()": ["T_STR", ["T_STR"]],
    "COERCIBILITY()": ["T_CMP", ["T_STR"]],

    "ATAN2()": ["T_CMP", ["T_CMP", "T_CMP"]],
    "CONCAT()": ["T_STR", ["T_STR", "T_STR"]],
    "CONCAT_WS()": ["T_STR", ["T_STR", "T_STR", "T_STR"]],
    "SUBSTRING()": ["T_STR", ["T_STR", "T_CMP"]],
    "LEFT()": ["T_STR", ["T_STR", "T_CMP"]],
    "RIGHT()": ["T_STR", ["T_STR", "T_CMP"]],
    "REPEAT()": ["T_STR", ["T_STR", "T_CMP"]],
    "REPLACE()": ["T_STR", ["T_STR", "T_STR", "T_STR"]],
    "SOUNDEX()": ["T_STR", ["T_STR"]],
    "SPACE()": ["T_STR", ["T_CMP"]],
    "UNHEX()": ["T_STR", ["T_STR"]],
    "JSON_VALID()": ["T_BOOL", ["T_STR"]],
    "ISNULL()": ["T_BOOL", ["T_ANY"]]
  },
  "promotions": {
    "T_CMP": ["T_BOOL", "T_STR"],
    "T_BOOL": ["T_CMP"],
    "T_STR": ["T_CMP"]
  },
