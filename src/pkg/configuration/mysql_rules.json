      "REPEAT()": {"0": "'probe_str'", "1": "1"},
      "REPLACE()": {"0": "'probe_str'", "1": "'probe'", "2": "'value'"}
    },
    "semantic_policy": {
      "definition_signatures": "bootstrap_hints_not_oracle",
      "manual_input_scope": "syntax_shape_and_initial_type_hints_only",
      "learned_scope": "slot_acceptance_edges_and_implicit_conversions_are_decided_by_rl_db_parser_feedback",
      "not_in_policy": "excluded_in_stage21_2b",
      "non_target_slot_fallback": "only_for_probe_construction_not_semantic_oracle"
    }
  },
  "sql_render": {
    "version": "stage21_2a_sql_render_v1",
    "operator_templates": {
      "IN": {
        "style": "in_list",
        "min_items": 1
      },
      "BETWEEN": {
        "style": "between"
      },
      "NOT BETWEEN": {
        "style": "between"
      },
      "IS": {
        "style": "binary_infix"
      },
      "IS NULL": {
        "style": "postfix"
      },
      "IS NOT NULL": {
        "style": "postfix"
      },
      "IS TRUE": {
        "style": "postfix"
      },
      "IS FALSE": {
        "style": "postfix"
      },
      "NOT": {
        "style": "prefix"
      },
      "!": {
        "style": "prefix"
      },
      "~": {
        "style": "prefix"
      },
      "-": {
        "style": "prefix"
      },
      "+": {
        "style": "prefix"
      },
      "LIKE": {
        "style": "binary_infix"
      },
      "NOT LIKE": {
        "style": "binary_infix"
      },
      "REGEXP": {
        "style": "binary_infix"
      },
      "NOT REGEXP": {
        "style": "binary_infix"
      }
    },
    "literal_profiles": {
      "cmp": "1",
      "float": "1.5",
      "string": "'probe_str'",
      "bool": "TRUE",
      "null": "NULL",
      "like_pattern": "'%probe%'",
      "regex_pattern": "'probe_str'",
      "allow_hex_int_literals": true
    }
  },
  "unary_operators": ["NOT", "!", "-", "+", "~"],
  "valid_types": [
    "INT", "TINYINT", "SMALLINT", "MEDIUMINT", "BIGINT", "HEX",
    "FLOAT", "DOUBLE", "DECIMAL", "NUMERIC", "REAL",
