    "semantic_policy": {
      "node_scope": "130 nodes: 22 condition operators, 61 comparable-scalar operators/functions, 21 string functions, 9 ordinary terminals and 17 stable system/function terminals",
      "definition_signatures": "Initial coarse scalar hints; not complete SQL Server overload or value-domain rules",
      "scalar_condition_boundary": "Scalar slots use T_CMP or T_STR, never wildcard T_ANY. Compatibility is a candidate level hint only: T_BOOL/scalar crossings remain available for database exploration; bit remains scalar in SQL rendering.",
      "learned_scope": "Numeric/string conversions and concrete operand combinations remain subject to database validation and Stage-3 type projection",
      "boolean_terminals": "TRUE/FALSE remain internal T_BOOL nodes, as in the other database rules. Final executable T-SQL must translate them to (1 = 1)/(1 = 0); current Python renderers do not implement this translation through JSON.",
      "not_in_policy": "Ordinary expression lists only; no subqueries or structural query terminals",
      "fixed_arity": "COALESCE, CONCAT, GREATEST and LEAST use two arguments; CONCAT_WS and CHOOSE use three; optional overloads are outside this node universe",
      "valid_types_scope": "Physical type and DSL inference hints, not callable functions. NCHAR is intentionally omitted from valid_types because NCHAR() is a real function; future datatype-wrapper mappings must also preserve it.",
      "temporal_and_binary_types": "TIMESTAMP and ROWVERSION are binary scalar aliases, not dates. Binary aliases do not add binary terminals or compression functions; hex integer sampling is disabled.",
      "session_terminals": "Connection identity and transaction state must remain unchanged during each TLP validation group",
      "precedence_scope": "SimpleParser binding powers: compound predicates bind as complete predicates before NOT/AND/OR; arithmetic and bitwise precedence follows T-SQL. Candidate + and - nodes are binary; generated operator expressions are parenthesized.",
      "offline_precedence_validation": "Microsoft ScriptDom 161.9142.1 groups << and >> with multiplication, unlike the documented addition-level precedence retained here. Generated expressions have explicit parentheses; unparenthesized mixed shift/arithmetic expressions need live SQL Server verification.",
